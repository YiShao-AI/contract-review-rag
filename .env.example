# Local-first configuration. Ollama must expose the listed chat and embedding
# models before the application starts.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5

EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text

# Retrieval and chunking
TOP_K=5
RERANK=0
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Local persistence
DATA_DIR=data

# Leave unset for localhost. Set a strong value before exposing the service to
# another machine or a tunnel.
# APP_PASSWORD=replace-with-a-strong-password
# COOKIE_SECURE=1  # required when the service is exposed through HTTPS

# A hosted chat-completions or embeddings endpoint can be used by replacing the
# corresponding base URL, key, and model. Source documents remain local, but
# prompts or embedding inputs sent to that endpoint follow its data policy.
